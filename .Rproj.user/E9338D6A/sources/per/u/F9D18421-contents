library(dplyr)
library(tidyr)
ogs<-read.table("../Orthogroups.tsv", fill = TRUE, sep = "\t", header = TRUE)
scogs<-read.table("../Orthogroups_SingleCopyOrthologues.txt")
all_inv_genes<-lapply(list.files(pattern = "genes_in_inv.txt"), read.table, header = FALSE) %>%
  bind_rows() %>%
  select(-c(V6:V8)) %>%
  mutate(V4 = paste(V9, V4, sep = "_")) %>%
  select(-V9) %>%
  group_by(V4) %>%
  mutate(count = n()) %>%
  filter(count == 1) %>%
  select(-count)
all_syn_genes<-lapply(list.files(pattern = "genes_in_syn.txt"), read.table, header = FALSE) %>%
  bind_rows() %>%
  mutate(V4 = paste(V9, V4, sep = "_")) %>%
  rename(gene = V4)
ref_gene_inv<-read.table("./ref_genes_inv.txt", fill = TRUE, sep = "\t", header = FALSE)
names(ref_gene_inv)<-c("gene", "inv")

###make orthofinder output long
ogs_long<-ogs %>%
  pivot_longer(cols = -Orthogroup, names_to = "genome", values_to = "gene") %>%
  separate_longer_delim(cols = gene, delim = ", ")

###combine orthogroup info for reference with inversion ids
ref_gene_og_inv<-ref_gene_inv %>%
  left_join(ogs_long)

###some genes are not in orthogroups but occur in inverted regions
###save them separately but filter for analysis
ref_specific_genes_inv<-ref_gene_og_inv %>%
  filter(is.na(Orthogroup)) %>%
  select(-c(Orthogroup, genome))

write.table(ref_specific_genes_inv, file = "ref_specific_genes_inv.txt", col.names = TRUE, row.names = FALSE, quote = FALSE, sep = "\t")

ref_gene_og_inv_filt<-ref_gene_og_inv %>%
  drop_na

###filter the orthogroup list to include only orthogroups with members in inverted regions
ogs_long %>%
  filter(Orthogroup %in% ref_gene_og_inv_filt$Orthogroup) %>%
  filter(genome != "AaegL5") %>%
  left_join(ref_gene_og_inv %>% select(Orthogroup, inv)) %>% View
  
ogs_long %>%
  filter(genome != "AaegL5") %>%
  left_join(ref_gene_og_inv_filt %>% select(Orthogroup, inv)) %>%
  unique %>%
  filter(gene %in% all_inv_genes$V4)

###combine orthogroup info with all inversion genes
all_inv_genes_ogs<-all_inv_genes %>%
  select(gene = V4, strand = V5) %>%
  left_join(ogs_long) %>%
  drop_na %>%
  as_tibble

all_inv_genes_ogs_filt<-all_inv_genes_ogs %>%
  filter(!(gene %in% all_syn_genes$gene))

mcogs_list<-all_inv_genes_ogs_filt %>%
  group_by(Orthogroup) %>%
  summarise(genes = paste(gene, collapse = ", "))


all_inv_genes_ogs_filt %>%
  group_by(gene) %>%
  mutate(count = n()) %>%
  filter(count > 1)


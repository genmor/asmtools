library(tidyverse)

dat<-read.delim("clipboard", header = F, sep = "\t")

dat %>%
  mutate(tmp = paste(V4, V5, sep = "_")) %>%
  pull(V2, name = tmp) %>%
  dist(.)

  pull(V2, name = paste(V4, V5, sep = "_"))

  
dat %>%
  group_by(V1, V4) %>%
  summarise(total = sum(sqrt(V2 - lag(V2))^2 + (V3-lag(V3))^2))


dat %>%
  ggplot() +
  geom_segment(aes(x = V2, xend = V3, y = V4), lwd = 5) +
  facet_wrap(. ~ V1, scale = 'free')

chr<-unique(dat$V1)

ch3_inv_dist<-dat %>%
  filter(V1 == chr[1]) %>%
  pull(V2, name = V4) %>%
  dist(x = . )

ch2_inv_dist<-dat %>%
  filter(V1 == chr[2]) %>%
  pull(V2, name = V4) %>%
  dist(x = . )


ch1_inv_dist<-dat %>%
  filter(V1 == chr[3]) %>%
  pull(V2, name = V4) %>%
  dist(x = .)


data.frame(as.matrix(ch1_inv_dist)) %>%
  rownames_to_column("inv1") %>%
  pivot_longer(cols = -inv1, names_to = "inv2", values_to = "distance") %>%
  filter(inv1 != inv2) %>%
  
reshape2::melt(as.matrix(ch1_inv_dist)) %>% head
  filter(as.numeric(row) > as.numeric(col))
  
  
reshape2::melt(as.matrix(ch1_inv_dist))[reshape2::melt(upper.tri(as.matrix(ch1_inv_dist))$value),]
